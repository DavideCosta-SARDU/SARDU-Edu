{
  "name": "@sardu-edu/desktop",
  "version": "0.1.0",
  "description": "Secure Electron desktop shell and hardware service for SARDU Edu",
  "license": "AGPL-3.0-only",
  "author": "Davide Costa <davide@sardu.pro>",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && vite build --mode main && vite build --mode preload && node scripts/verify-preload.cjs && electron-builder --dir",
    "clean": "rimraf dist release",
    "format": "prettier --write . && eslint --fix",
    "lint": "eslint && prettier --check .",
    "start": "electron .",
    "test": "npm run lint && vitest run"
  },
  "devDependencies": {
    "@sardu-edu/hardware": "0.1.0",
    "@types/node": "24.9.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.66",
    "prettier": "3.9.6",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "pro.sardu.edu",
    "productName": "SARDU Edu",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../scratch-gui/build",
        "to": "gui"
      },
      {
        "from": "resources",
        "to": "hardware"
      },
      {
        "from": "../../LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "legal/NOTICE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      }
    ]
  }
}
