{
  "name": "@sardu-edu/hardware",
  "version": "0.1.0",
  "description": "Modular hardware definitions and compatibility checks for SARDU Edu",
  "license": "AGPL-3.0-only",
  "author": "Davide Costa <davide@sardu.pro>",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/sardu-edu-hardware.js",
      "require": "./dist/sardu-edu-hardware.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/sardu-edu-hardware.umd.cjs",
  "module": "dist/sardu-edu-hardware.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && vite build",
    "clean": "rimraf dist",
    "format": "prettier --write . && eslint --fix",
    "lint": "eslint && prettier --check .",
    "test": "npm run lint && vitest run"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.66",
    "prettier": "3.9.6",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "unplugin-dts": "1.1.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.11"
  }
}
